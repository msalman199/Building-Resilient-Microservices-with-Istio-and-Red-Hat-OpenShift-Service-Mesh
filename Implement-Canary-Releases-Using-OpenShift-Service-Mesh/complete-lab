Subtask 3.9: Implement Rollback Strategy
Create a rollback procedure to quickly revert to stable versions.

# Create rollback script
cat <<EOF > rollback.sh
#!/bin/bash

NAMESPACE=\${1:-canary-demo}

echo "Initiating rollback procedure..."

# Step 1: Route all traffic back to stable version (v1)
echo "Step 1: Routing all traffic to stable version (v1)"
cat <<ROLLBACK_EOF | oc apply -f -
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: webapp-vs
  namespace: \$NAMESPACE
spec:
  hosts:
  - "*"
  gateways:
  - webapp-gateway
  http:
  - match:
    - uri:
        prefix: /
    route:
    - destination:
        host: webapp-service
        subset: v1
      weight: 100
    - destination:
        host: webapp-service
        subset: v2
      weight: 0
    - destination:
        host: webapp-service
        subset: v3
      weight: 0
ROLLBACK_EOF

echo "Step 2: Scaling down problematic deployments"
oc scale deployment webapp-v3 --replicas=0 -n \$NAMESPACE

echo "Step 3: Verifying rollback"
sleep 5
for i in {1..5}; do
    curl -s http://\$GATEWAY_URL | grep -o "Version: [0-9.]*"
    sleep 1
done

echo "Rollback completed successfully!"
EOF

chmod +x rollback.sh

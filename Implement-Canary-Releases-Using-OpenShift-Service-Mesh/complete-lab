Subtask 1.3: Deploy the Stable Version of the Application
Deploy the initial stable version of a sample web application.

# Create the stable version deployment
cat <<EOF | oc apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webapp-v1
  namespace: canary-demo
  labels:
    app: webapp
    version: v1
spec:
  replicas: 3
  selector:
    matchLabels:
      app: webapp
      version: v1
  template:
    metadata:
      labels:
        app: webapp
        version: v1
      annotations:
        sidecar.istio.io/inject: "true"
    spec:
      containers:
      - name: webapp
        image: nginx:1.20
        ports:
        - containerPort: 80
        volumeMounts:
        - name: html-content
          mountPath: /usr/share/nginx/html
      volumes:
      - name: html-content
        configMap:
          name: webapp-v1-content
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: webapp-v1-content
  namespace: canary-demo
data:
  index.html: |
    <!DOCTYPE html>
    <html>
    <head>
        <title>Web App v1.0</title>
        <style>
            body { font-family: Arial, sans-serif; background-color: #e3f2fd; text-align: center; padding: 50px; }
            .version { color: #1976d2; font-size: 24px; font-weight: bold; }
        </style>
    </head>
    <body>
        <h1>Welcome to Web Application</h1>
        <p class="version">Version: 1.0 (Stable)</p>
        <p>This is the stable version of the application.</p>
    </body>
    </html>
EOF

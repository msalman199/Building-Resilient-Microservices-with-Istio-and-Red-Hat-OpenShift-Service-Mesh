Task 3: Monitor Canary Version Health and Rollback if Needed
Subtask 3.1: Install Monitoring Tools
Set up basic monitoring to observe application metrics.

# Create a simple monitoring script
cat <<EOF > monitor_canary.sh
#!/bin/bash

GATEWAY_URL=\$1
DURATION=\${2:-60}
INTERVAL=\${3:-2}

if [ -z "\$GATEWAY_URL" ]; then
    echo "Usage: \$0 <gateway_url> [duration_seconds] [interval_seconds]"
    exit 1
fi

echo "Monitoring canary deployment for \$DURATION seconds..."
echo "Timestamp,Version,Response_Time,Status_Code"

end_time=\$((SECONDS + DURATION))

while [ \$SECONDS -lt \$end_time ]; do
    timestamp=\$(date '+%Y-%m-%d %H:%M:%S')
    
    # Make request and capture metrics
    response=\$(curl -s -w "%{time_total},%{http_code}" -o /tmp/response.html http://\$GATEWAY_URL)
    response_time=\$(echo \$response | cut -d',' -f1)
    status_code=\$(echo \$response | cut -d',' -f2)
    
    # Extract version from response
    version=\$(grep -o "Version: [0-9.]*" /tmp/response.html | cut -d' ' -f2)
    
    echo "\$timestamp,\$version,\$response_time,\$status_code"
    
    sleep \$INTERVAL
done
EOF

chmod +x monitor_canary.sh

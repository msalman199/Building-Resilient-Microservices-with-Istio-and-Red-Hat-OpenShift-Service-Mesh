Subtask 3.7: Implement Health Checks
Create health check rules to automatically detect issues.

# Create a health check script
cat <<EOF > health_check.sh
#!/bin/bash

GATEWAY_URL=\$1
THRESHOLD_RESPONSE_TIME=1.0
ERROR_THRESHOLD=5

if [ -z "\$GATEWAY_URL" ]; then
    echo "Usage: \$0 <gateway_url>"
    exit 1
fi

echo "Performing health check..."

# Test multiple requests
total_requests=10
slow_requests=0
error_requests=0

for i in \$(seq 1 \$total_requests); do
    response=\$(curl -s -w "%{time_total},%{http_code}" -o /dev/null http://\$GATEWAY_URL)
    response_time=\$(echo \$response | cut -d',' -f1)
    status_code=\$(echo \$response | cut -d',' -f2)
    
    # Check if response time is too high
    if (( \$(echo "\$response_time > \$THRESHOLD_RESPONSE_TIME" | bc -l) )); then
        slow_requests=\$((slow_requests + 1))
    fi
    
    # Check for HTTP errors
    if [ "\$status_code" != "200" ]; then
        error_requests=\$((error_requests + 1))
    fi
    
    sleep 0.5
done

echo "Health Check Results:"
echo "Total requests: \$total_requests"
echo "Slow requests (>\${THRESHOLD_RESPONSE_TIME}s): \$slow_requests"
echo "Error requests: \$error_requests"

# Determine if rollback is needed
if [ \$slow_requests -gt 2 ] || [ \$error_requests -gt 0 ]; then
    echo "HEALTH CHECK FAILED - Rollback recommended!"
    exit 1
else
    echo "HEALTH CHECK PASSED - Application is healthy"
    exit 0
fi
EOF

chmod +x health_check.sh

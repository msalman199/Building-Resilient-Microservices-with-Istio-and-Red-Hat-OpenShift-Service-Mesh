Task 2: Route Traffic to the New Version Incrementally
Subtask 2.1: Create Istio Gateway
Create an Istio Gateway to expose the application externally.

# Create Gateway configuration
cat <<EOF | oc apply -f -
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: webapp-gateway
  namespace: canary-demo
spec:
  selector:
    istio: ingressgateway
  servers:
  - port:
      number: 80
      name: http
      protocol: HTTP
    hosts:
    - "*"
EOF
Subtask 2.2: Create Initial VirtualService (100% Stable)
Start with all traffic going to the stable version.

# Create VirtualService with 100% traffic to v1
cat <<EOF | oc apply -f -
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: webapp-vs
  namespace: canary-demo
spec:
  hosts:
  - "*"
  gateways:
  - webapp-gateway
  http:
  - match:
    - uri:
        prefix: /
    route:
    - destination:
        host: webapp-service
        subset: v1
      weight: 100
    - destination:
        host: webapp-service
        subset: v2
      weight: 0
EOF
Subtask 2.3: Create DestinationRule
Define subsets for different versions of the application.

# Create DestinationRule to define version subsets
cat <<EOF | oc apply -f -
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: webapp-dr
  namespace: canary-demo
spec:
  host: webapp-service
  subsets:
  - name: v1
    labels:
      version: v1
  - name: v2
    labels:
      version: v2
EOF

Task 4: Set Up Alerts for Abnormal Service Behavior
Subtask 4.1: Configure Prometheus Alert Rules
Create alert rules for monitoring service health:

# Create PrometheusRule for Istio alerts
cat <<EOF | oc apply -f -
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: istio-alerts
  namespace: istio-system
  labels:
    app: istio-proxy
    release: istio
spec:
  groups:
  - name: istio.rules
    rules:
    - alert: IstioHighRequestLatency
      expr: histogram_quantile(0.99, rate(istio_request_duration_milliseconds_bucket{destination_service_namespace="bookinfo-observability"}[5m])) > 1000
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "High request latency detected"
        description: "Request latency is above 1000ms for service {{ \$labels.destination_service_name }}"
    
    - alert: IstioHighErrorRate
      expr: rate(istio_requests_total{destination_service_namespace="bookinfo-observability",response_code!~"2.."}[5m]) > 0.1
      for: 2m
      labels:
        severity: critical
      annotations:
        summary: "High error rate detected"
        description: "Error rate is above 10% for service {{ \$labels.destination_service_name }}"
    
    - alert: IstioServiceDown
      expr: up{job="istio-proxy"} == 0
      for: 1m
      labels:
        severity: critical
      annotations:
        summary: "Istio service is down"
        description: "Istio proxy for {{ \$labels.instance }} has been down for more than 1 minute"
    
    - alert: IstioLowRequestRate
      expr: rate(istio_requests_total{destination_service_namespace="bookinfo-observability"}[5m]) < 0.01
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "Low request rate detected"
        description: "Request rate is below 0.01 req/sec for service {{ \$labels.destination_service_name }}"
EOF
Subtask 4.2: Configure Alertmanager
Set up Alertmanager to handle alert notifications:

# Create Alertmanager configuration
cat <<EOF | oc apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-main
  namespace: istio-system
type: Opaque
stringData:
  alertmanager.yml: |
    global:
      smtp_smarthost: 'localhost:587'
      smtp_from: 'alerts@example.com'
    
    route:
      group_by: ['alertname']
      group_wait: 10s
      group_interval: 10s
      repeat_interval: 1h
      receiver: 'web.hook'
      routes:
      - match:
          severity: critical
        receiver: 'critical-alerts'
      - match:
          severity: warning
        receiver: 'warning-alerts'
    
    receivers:
    - name: 'web.hook'
      webhook_configs:
      - url: 'http://localhost:5001/'
    
    - name: 'critical-alerts'
      webhook_configs:
      - url: 'http://localhost:5001/critical'
        send_resolved: true
    
    - name: 'warning-alerts'
      webhook_configs:
      - url: 'http://localhost:5001/warning'
        send_resolved: true
EOF

Subtask 4.5: Create Service Level Objectives (SLOs)
Define and monitor SLOs for your services:

# Create SLO configuration
cat <<EOF | oc apply -f -
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: bookinfo-slo
  namespace: istio-system
spec:
  groups:
  - name: bookinfo.slo
    rules:
    - record: bookinfo:availability_rate5m
      expr: |
        (
          rate(istio_requests_total{destination_service_namespace="bookinfo-observability",response_code!~"5.."}[5m])
          /
          rate(istio_requests_total{destination_service_namespace="bookinfo-observability"}[5m])
        )
    
    - record: bookinfo:latency_p99_5m
      expr: |
        histogram_quantile(0.99,
          rate(istio_request_duration_milliseconds_bucket{destination_service_namespace="bookinfo-observability"}[5m])
        )
    
    - alert: BookinfoSLOAvailabilityBreach
      expr: bookinfo:availability_rate5m < 0.99
      for: 2m
      labels:
        severity: critical
        slo: availability
      annotations:
        summary: "Bookinfo availability SLO breach"
        description: "Availability is {{ \$value | humanizePercentage }} which is below 99% SLO"
    
    - alert: BookinfoSLOLatencyBreach
      expr: bookinfo:latency_p99_5m > 500
      for: 5m
      labels:
        severity: warning
        slo: latency
      annotations:
        summary: "Bookinfo latency SLO breach"
        description: "99th percentile latency is {{ \$value }}ms which is above 500ms SLO"
EOF
Advanced Observability Features
Subtask 5.1: Configure Distributed Tracing
Enable and configure Jaeger for distributed tracing:

# Check if Jaeger is installed
oc get pods -n istio-system | grep jaeger

# Create route for Jaeger UI
oc expose service jaeger-query -n istio-system --name=jaeger-route

# Get Jaeger URL
export JAEGER_URL=$(oc get route jaeger-route -n istio-system -o jsonpath='{.spec.host}')
echo "Jaeger URL: http://$JAEGER_URL"

# Generate traced requests
for i in {1..20}; do
  curl -H "x-request-id: trace-$i" "http://$GATEWAY_URL/productpage"
  sleep 2
done
Subtask 5.2: Configure Custom Metrics
Create custom metrics for business-specific monitoring:

# Create EnvoyFilter for custom metrics
cat <<EOF | oc apply -f -
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: custom-metrics
  namespace: bookinfo-observability
spec:
  configPatches:
  - applyTo: HTTP_FILTER
    match:
      context: SIDECAR_INBOUND
      listener:
        filterChain:
          filter:
            name: "envoy.filters.network.http_connection_manager"
    patch:
      operation: INSERT_BEFORE
      value:
        name: envoy.filters.http.wasm
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.http.wasm.v3.Wasm
          config:
            configuration:
              "@type": type.googleapis.com/google.protobuf.StringValue
              value: |
                {
                  "metric_name": "custom_requests_total",
                  "labels": {
                    "custom_label": "custom_value"
                  }
                }
EOF
Troubleshooting Common Issues
Issue 1: Metrics Not Appearing
If metrics are not showing up in Prometheus:

# Check if Istio proxy is injected
oc get pods -n bookinfo-observability -o jsonpath='{.items[*].spec.containers[*].name}'

# Verify ServiceMonitor exists
oc get servicemonitor -n istio-system

# Check Prometheus targets
curl -s "http://$PROMETHEUS_URL/api/v1/targets" | jq '.data.activeTargets[] | select(.labels.job=="istio-proxy")'
Issue 2: Grafana Dashboard Not Loading
If Grafana dashboards are not loading properly:

# Check Grafana pod logs
oc logs -n istio-system deployment/grafana

# Verify Grafana can reach Prometheus
oc exec -n istio-system deployment/grafana -- curl -s http://prometheus:9090/api/v1/query?query=up
Issue 3: Alerts Not Firing
If alerts are not triggering:

# Check PrometheusRule status
oc get prometheusrule -n istio-system istio-alerts -o yaml

# Verify alert rules are loaded in Prometheus
curl -s "http://$PROMETHEUS_URL/api/v1/rules" | jq '.data.groups[].rules[] | select(.type=="alerting")'

# Check Alertmanager status
oc get pods -n istio-system | grep alertmanager
Performance Optimization
Optimize Metrics Collection
# Configure metrics collection intervals
cat <<EOF | oc apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: istio
  namespace: istio-system
data:
  mesh: |
    defaultConfig:
      proxyStatsMatcher:
        inclusionRegexps:
        - ".*outlier_detection.*"
        - ".*circuit_breakers.*"
        - ".*upstream_rq_retry.*"
        - ".*_cx_.*"
        exclusionRegexps:
        - ".*osconfig.*"
EOF

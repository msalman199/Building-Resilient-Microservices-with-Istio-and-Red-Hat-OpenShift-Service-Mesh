    kubectl logs --tail=5 deployment/productpage-v1 -n traffic-mirror-lab -c productpage 2>/dev/null | \
        grep "GET /productpage" | tail -3 | sed 's/^/  /'
    
    echo "Staging (last 5 requests):"
    kubectl logs --tail=5 deployment/productpage-v2 -n traffic-mirror-lab -c productpage 2>/dev/null | \

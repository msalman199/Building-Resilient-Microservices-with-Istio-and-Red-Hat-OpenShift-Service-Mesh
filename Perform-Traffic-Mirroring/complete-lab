#!/bin/bash

# Continuous monitoring script
echo "Starting Traffic Mirror Monitoring..."
echo "Press Ctrl+C to stop"

while true; do
    clear
    echo "=== Traffic Mirroring Dashboard ==="
    echo "Timestamp: $(date)"
    echo "=================================="
    
    # Production pods status
    echo "Production Pods (v1):"
    kubectl get pods -n traffic-mirror-lab -l version=v1 --no-headers | \

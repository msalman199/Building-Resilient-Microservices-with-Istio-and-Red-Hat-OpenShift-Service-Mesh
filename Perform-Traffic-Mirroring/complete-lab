Subtask 3.3: Analyze Traffic Patterns and Performance
Step 13: Create analysis scripts to compare production vs staging performance

Create a file called traffic-analysis.sh:

#!/bin/bash

echo "=== Traffic Mirroring Analysis ==="
echo "Timestamp: $(date)"
echo

# Function to get pod metrics
get_pod_metrics() {
    local version=$1
    echo "=== Metrics for $version ==="
    
    # Get CPU and Memory usage
    kubectl top pod -n traffic-mirror-lab -l version=$version
    
    # Get request count from logs
    local pod_name=$(kubectl get pods -n traffic-mirror-lab -l version=$version -o jsonpath='{.items[0].metadata.name}')
    local request_count=$(kubectl logs $pod_name -n traffic-mirror-lab -c productpage | grep -c "GET /productpage" || echo "0")
    echo "Total requests processed: $request_count"
    echo
}

# Analyze production version (v1)
get_pod_metrics "v1"

# Analyze staging version (v2) 
get_pod_metrics "v2"

# Check Istio proxy stats
echo "=== Istio Proxy Statistics ==="
kubectl exec -n traffic-mirror-lab deployment/productpage-v1 -c istio-proxy -- \
  curl -s localhost:15000/stats | grep -E "(inbound|outbound).*productpage.*" | head -10

echo
echo "=== Mirror Traffic Verification ==="
# Check if mirrored traffic is being sent
kubectl exec -n traffic-mirror-lab deployment/productpage-v2 -c istio-proxy -- \
  curl -s localhost:15000/stats | grep mirror || echo "No mirror stats found"
Make the script executable and run it:

# Make script executable

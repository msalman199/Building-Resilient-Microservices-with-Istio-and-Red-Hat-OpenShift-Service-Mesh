Task 1: Deploy a Simple Microservice Application
Subtask 1.1: Create Project and Namespace
First, we'll create a dedicated project for our microservice application.

# Create a new project for the microservice application
oc new-project bookinfo-microservices

# Verify the project creation
oc project bookinfo-microservices
Subtask 1.2: Enable Service Mesh for the Namespace
Configure the namespace to be part of the service mesh by adding the necessary labels and creating a ServiceMeshMemberRoll.

# Label the namespace for automatic sidecar injection
oc label namespace bookinfo-microservices istio-injection=enabled

# Verify the label was applied
oc get namespace bookinfo-microservices --show-labels
Create a ServiceMeshMemberRoll to include our namespace:

# Create ServiceMeshMemberRoll configuration
cat << EOF | oc apply -f -
apiVersion: maistra.io/v1
kind: ServiceMeshMemberRoll
metadata:
  name: default
  namespace: istio-system
spec:
  members:
  - bookinfo-microservices
EOF
Subtask 1.3: Deploy the Bookinfo Sample Application
We'll deploy the classic Bookinfo application, which consists of four microservices: productpage, details, reviews, and ratings.

# Deploy the Bookinfo application
cat << EOF | oc apply -f -
# Details service
apiVersion: v1
kind: Service
metadata:
  name: details
  labels:
    app: details
    service: details
spec:
  ports:
  - port: 9080
    name: http
  selector:
    app: details
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bookinfo-details
  labels:
    account: details
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: details-v1
  labels:
    app: details
    version: v1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: details
      version: v1
  template:
    metadata:
      labels:
        app: details
        version: v1
    spec:
      serviceAccountName: bookinfo-details
      containers:
      - name: details
        image: docker.io/istio/examples-bookinfo-details-v1:1.17.0
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 9080
        securityContext:
          runAsUser: 1000
---
# Ratings service
apiVersion: v1
kind: Service
metadata:
  name: ratings
  labels:
    app: ratings
    service: ratings
spec:
  ports:
  - port: 9080
    name: http
  selector:
    app: ratings
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bookinfo-ratings
  labels:
    account: ratings
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ratings-v1
  labels:
    app: ratings

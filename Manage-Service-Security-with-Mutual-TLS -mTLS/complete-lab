Test Service Communication
# Test communication between services
oc exec -n bookinfo-mtls sleep -- curl -s http://productpage:9080/health

# Test communication to details service
oc exec -n bookinfo-mtls sleep -- curl -s http://details:9080/details/1
Task 2: Configure Security Policies for Service Communication
Subtask 2.1: Create Destination Rules for mTLS
Configure Destination Rules
# Create destination rules to specify mTLS settings
cat <<EOF | oc apply -f -
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: productpage
  namespace: bookinfo-mtls
spec:
  host: productpage
  trafficPolicy:
    tls:
      mode: ISTIO_MUTUAL
---
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: details
  namespace: bookinfo-mtls
spec:
  host: details
  trafficPolicy:
    tls:
      mode: ISTIO_MUTUAL
EOF
Verify Destination Rules
# Check destination rules
oc get destinationrule -n bookinfo-mtls

# Describe the destination rule configuration
oc describe destinationrule productpage -n bookinfo-mtls
Subtask 2.2: Implement Authorization Policies
Create Authorization Policies
# Create an authorization policy to control access
cat <<EOF | oc apply -f -
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: productpage-viewer
  namespace: bookinfo-mtls
spec:
  selector:
    matchLabels:
      app: productpage
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/bookinfo-mtls/sa/bookinfo-productpage"]
  - to:
    - operation:
        methods: ["GET"]
---
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: details-viewer
  namespace: bookinfo-mtls
spec:
  selector:
    matchLabels:
      app: details
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/bookinfo-mtls/sa/bookinfo-productpage"]
  - to:
    - operation:
        methods: ["GET"]
EOF
Verify Authorization Policies
# Check authorization policies
oc get authorizationpolicy -n bookinfo-mtls

# Describe the authorization policy
oc describe authorizationpolicy productpage-viewer -n bookinfo-mtls
Subtask 2.3: Configure Service-Specific mTLS Settings
Create Service-Specific PeerAuthentication
# Create specific mTLS settings for the details service
cat <<EOF | oc apply -f -
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: details-mtls
  namespace: bookinfo-mtls
spec:
  selector:
    matchLabels:
      app: details
  mtls:
    mode: STRICT
  portLevelMtls:
    9080:
      mode: STRICT
EOF
Create Workload-Specific Policies
# Create workload-specific authentication policy
cat <<EOF | oc apply -f -
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: productpage-mtls
  namespace: bookinfo-mtls
spec:
  selector:
    matchLabels:
      app: productpage
      version: v1
  mtls:
    mode: STRICT
EOF
Task 3: Test Service Communication Security
Subtask 3.1: Verify mTLS Certificate Exchange
Check Certificate Information
# Get the productpage pod name
PRODUCTPAGE_POD=$(oc get pod -l app=productpage -n bookinfo-mtls -o jsonpath='{.items[0].metadata.name}')

# Check certificate details
istioctl proxy-config secret $PRODUCTPAGE_POD -n bookinfo-mtls
Verify Certificate Rotation
# Check certificate expiration and rotation
oc exec -n bookinfo-mtls $PRODUCTPAGE_POD -c istio-proxy -- openssl s_client -connect details:9080 -cert /etc/ssl/certs/cert-chain.pem -key /etc/ssl/private/key.pem -CAfile /etc/ssl/certs/root-cert.pem
Subtask 3.2: Test Communication Security
Test Authorized Communication
# Test communication from productpage to details (should work)
PRODUCTPAGE_POD=$(oc get pod -l app=productpage -n bookinfo-mtls -o jsonpath='{.items[0].metadata.name}')

oc exec -n bookinfo-mtls $PRODUCTPAGE_POD -c productpage -- curl -s http://details:9080/details/1
Test Unauthorized Communication
# Create a pod without proper service account
cat <<EOF | oc apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: unauthorized-client
  namespace: bookinfo-mtls
  labels:
    app: unauthorized
spec:
  containers:
  - name: client
    image: curlimages/curl
    command: ["/bin/sleep", "3650d"]
    imagePullPolicy: IfNotPresent
EOF
# Test communication from unauthorized pod (should fail)
oc exec -n bookinfo-mtls unauthorized-client -- curl -s http://details:9080/details/1 -v
Subtask 3.3: Monitor and Analyze mTLS Traffic
Check mTLS Status with Kiali
# Get Kiali route (if available)
oc get route kiali -n istio-system

# Alternative: Use port-forward to access Kiali
oc port-forward svc/kiali 20001:20001 -n istio-system
Analyze Traffic with Istioctl
# Check proxy configuration for mTLS
istioctl proxy-config cluster $PRODUCTPAGE_POD -n bookinfo-mtls

# Verify listener configuration
istioctl proxy-config listener $PRODUCTPAGE_POD -n bookinfo-mtls
Monitor Certificate Status
# Check certificate status across all workloads
istioctl authn tls-check -n bookinfo-mtls

# Get detailed certificate information
for pod in $(oc get pods -n bookinfo-mtls -o jsonpath='{.items[*].metadata.name}'); do
  echo "=== Certificate info for $pod ==="
  istioctl proxy-config secret $pod -n bookinfo-mtls
done
Subtask 3.4: Test mTLS Policy Enforcement
Create Test Scenarios
# Test 1: Disable mTLS temporarily and verify failure
cat <<EOF | oc apply -f -
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: disable-mtls-test
  namespace: bookinfo-mtls
spec:
  selector:
    matchLabels:
      app: details
  mtls:
    mode: DISABLE
EOF
Verify Policy Changes
# Wait for policy to take effect
sleep 30

# Test communication (should still work but without mTLS)
oc exec -n bookinfo-mtls $PRODUCTPAGE_POD -c productpage -- curl -s http://details:9080/details/1

# Check mTLS status
istioctl authn tls-check $PRODUCTPAGE_POD.bookinfo-mtls details.bookinfo-mtls.svc.cluster.local
Restore Strict mTLS
# Remove the disable policy
oc delete peerauthentication disable-mtls-test -n bookinfo-mtls

# Verify mTLS is restored
sleep 30
istioctl authn tls-check $PRODUCTPAGE_POD.bookinfo-mtls details.bookinfo-mtls.svc.cluster.local
Troubleshooting Common Issues
Issue 1: mTLS Not Working
Symptoms: Services cannot communicate, connection refused errors

Solutions:

# Check if sidecars are properly injected
oc get pods -n bookinfo-mtls -o jsonpath='{.items[*].spec.containers[*].name}'

# Verify PeerAuthentication policies
oc get peerauthentication -n bookinfo-mtls -o yaml

# Check destination rules
oc get destinationrule -n bookinfo-mtls -o yaml
Issue 2: Certificate Issues
Symptoms: TLS handshake failures, certificate validation errors

Solutions:

# Check certificate status
istioctl proxy-config secret -n bookinfo-mtls

# Verify certificate chain
oc exec -n bookinfo-mtls $PRODUCTPAGE_POD -c istio-proxy -- ls -la /etc/ssl/certs/

# Check certificate expiration
istioctl proxy-config secret $PRODUCTPAGE_POD -n bookinfo-mtls | grep EXPIRE
Issue 3: Authorization Policy Conflicts
Symptoms: Unexpected access denials or permissions

Solutions:

# List all authorization policies
oc get authorizationpolicy -n bookinfo-mtls

# Check policy details
oc describe authorizationpolicy -n bookinfo-mtls

# Verify service account principals
oc get serviceaccount -n bookinfo-mtls

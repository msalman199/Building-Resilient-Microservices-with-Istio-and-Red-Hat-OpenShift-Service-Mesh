Task 1: Enable mTLS Between Services
Subtask 1.1: Verify Service Mesh Installation
First, let's verify that OpenShift Service Mesh is properly installed and running.

Check Service Mesh Control Plane Status
# Verify the Service Mesh control plane is running
oc get smcp -n istio-system

# Check all Service Mesh components
oc get pods -n istio-system
Verify Istio Configuration
# Check Istio version and configuration
istioctl version

# Verify proxy configuration
istioctl proxy-config cluster -n bookinfo
Subtask 1.2: Deploy Sample Applications
We'll use a sample bookinfo application to demonstrate mTLS configuration.

Create Application Namespace
# Create a new namespace for our application
oc new-project bookinfo-mtls

# Label the namespace for automatic sidecar injection
oc label namespace bookinfo-mtls istio-injection=enabled
Deploy Sample Applications
# Deploy the bookinfo application
cat <<EOF | oc apply -f -
apiVersion: v1
kind: Service
metadata:
  name: productpage
  namespace: bookinfo-mtls
  labels:
    app: productpage
    service: productpage
spec:
  ports:
  - port: 9080
    name: http
  selector:
    app: productpage
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bookinfo-productpage
  namespace: bookinfo-mtls
  labels:
    account: productpage
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: productpage-v1
  namespace: bookinfo-mtls
  labels:
    app: productpage
    version: v1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: productpage
      version: v1
  template:
    metadata:
      labels:
        app: productpage
        version: v1
    spec:
      serviceAccountName: bookinfo-productpage
      containers:
      - name: productpage
        image: docker.io/istio/examples-bookinfo-productpage-v1:1.17.0
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 9080
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        securityContext:
          runAsUser: 1000
      volumes:
      - name: tmp
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: details
  namespace: bookinfo-mtls
  labels:
    app: details
    service: details
spec:
  ports:
  - port: 9080
    name: http
  selector:
    app: details
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bookinfo-details
  namespace: bookinfo-mtls
  labels:
    account: details
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: details-v1
  namespace: bookinfo-mtls
  labels:
    app: details
    version: v1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: details
      version: v1
  template:
    metadata:
      labels:
        app: details
        version: v1
    spec:
      serviceAccountName: bookinfo-details
      containers:
      - name: details
        image: docker.io/istio/examples-bookinfo-details-v1:1.17.0
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 9080
        securityContext:
          runAsUser: 1000
EOF
Verify Application Deployment
# Check if pods are running with sidecars
oc get pods -n bookinfo-mtls

# Verify sidecar injection
oc describe pod -l app=productpage -n bookinfo-mtls | grep -i containers -A 10
Subtask 1.3: Configure Automatic mTLS
Create PeerAuthentication Policy
# Create a PeerAuthentication policy to enforce mTLS
cat <<EOF | oc apply -f -
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: default
  namespace: bookinfo-mtls
spec:
  mtls:
    mode: STRICT
EOF
Verify mTLS Configuration
# Check the PeerAuthentication policy
oc get peerauthentication -n bookinfo-mtls

# Verify mTLS status using istioctl
istioctl authn tls-check productpage-v1-<pod-suffix>.bookinfo-mtls details.bookinfo-mtls.svc.cluster.local
Note: Replace <pod-suffix> with the actual pod suffix from your deployment.

Subtask 1.4: Test Basic mTLS Communication
Create a Test Pod
# Deploy a test pod to verify communication
cat <<EOF | oc apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: sleep

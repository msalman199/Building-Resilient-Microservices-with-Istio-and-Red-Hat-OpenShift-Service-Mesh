Subtask 3.5: Identify Bottlenecks Using Metrics
Create additional load to identify bottlenecks:

# Create high-load traffic script
cat << 'EOF' > high_load_traffic.sh
#!/bin/bash

INGRESS_HOST=$(kubectl get po -l istio=ingressgateway -n istio-system -o jsonpath='{.items[0].status.hostIP}')
INGRESS_PORT=$(kubectl -n istio-system get service istio-ingressgateway -o jsonpath='{.spec.ports[?(@.name=="http2")].nodePort}')
GATEWAY_URL=$INGRESS_HOST:$INGRESS_PORT

echo "Generating high load traffic..."

# Generate concurrent requests
for i in {1..10}; do
    (
        for j in {1..20}; do
            curl -s "http://$GATEWAY_URL/productpage" > /dev/null
            sleep 0.1
        done
    ) &
done

wait
echo "High load traffic generation completed"
EOF

chmod +x high_load_traffic.sh
./high_load_traffic.sh

Subtask 3.4: Create Custom Circuit Breaker Profiles
Step 1: Create Different Profiles for Different Services
Create a high-traffic service profile:

cat <<EOF > high-traffic-circuit-breaker.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: high-traffic-profile
  namespace: circuit-breaker-demo
spec:
  host: backend.circuit-breaker-demo.svc.cluster.local
  trafficPolicy:
    outlierDetection:
      consecutiveGatewayErrors: 5
      consecutive5xxErrors: 5
      interval: 30s
      baseEjectionTime: 60s
      maxEjectionPercent: 50
      minHealthPercent: 30
    connectionPool:
      tcp:
        maxConnections: 100
        connectTimeout: 10s
      http:
        http1MaxPendingRequests: 50
        http2MaxRequests: 100
        maxRequestsPerConnection: 10
        maxRetries: 3
  portLevelSettings:
  - port:
      number: 80
    connectionPool:
      tcp:
        maxConnections: 50
EOF
Create a critical service profile:

cat <<EOF > critical-service-circuit-breaker.yaml
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: critical-service-profile
  namespace: circuit-breaker-demo
spec:
  host: backend.circuit-breaker-demo.svc.cluster.local
  trafficPolicy:
    outlierDetection:
      consecutiveGatewayErrors: 1
      consecutive5xxErrors: 1
      interval: 5s
      baseEjectionTime: 10s
      maxEjectionPercent: 90
      minHealthPercent: 10
    connectionPool:
      tcp:
        maxConnections: 5
        connectTimeout: 2s
      http:
        http1MaxPendingRequests: 2
        http2MaxRequests: 5
        maxRequestsPerConnection: 1
        maxRetries: 1
EOF

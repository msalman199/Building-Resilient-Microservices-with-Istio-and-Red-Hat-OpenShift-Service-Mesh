Subtask 2.7: Generate Sustained Load for Monitoring
Create a sustained load test to observe patterns in the dashboards:

# Create sustained load test
cat <<EOF > /tmp/sustained-load-test.sh
#!/bin/bash
LOAD_TESTER_POD=\$(kubectl get pod -l app=load-tester -n resilient-apps -o jsonpath='{.items[0].metadata.name}')

echo "Starting sustained load test for 5 minutes..."
echo "Monitor the dashboards at:"
echo "Kiali: http://localhost:20001"
echo "Grafana: http://localhost:3000"

# Function to generate normal traffic
generate_normal_traffic() {
  while true; do
    kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -o /dev/null http://backend:8080/ 2>/dev/null
    sleep 0.5
  done
}

# Function to generate fault traffic
generate_fault_traffic() {
  while true; do
    kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -H "test-fault: abort" -o /dev/null http://backend:8080/ 2>/dev/null
    sleep 2
  done
}

# Function to generate delay traffic
generate_delay_traffic() {
  while true; do
    kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -H "test-fault: delay" -o /dev/null http://backend:8080/ 2>/dev/null
    sleep 3
  done
}

# Start background traffic generators
generate_normal_traffic &
NORMAL_PID=\$!

generate_fault_traffic &
FAULT_PID=\$!

generate_delay_traffic &
DELAY_PID=\$!

echo "Load test running... Check your dashboards!"
echo "Press Ctrl+C to stop the test"

# Wait for user interrupt
trap "kill \$NORMAL_PID \$FAULT_PID \$DELAY_PID; echo 'Load test stopped'; exit" INT
sleep 300

# Clean up
kill \$NORMAL_PID \$FAULT_PID \$DELAY_PID
echo "5-minute load test completed"
EOF

# Run the sustained load test
chmod +x /tmp/sustained-load-test.sh
bash /tmp/sustained-load-test.sh

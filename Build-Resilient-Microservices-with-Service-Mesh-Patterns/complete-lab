---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: resilient-apps
spec:
  selector:
    app: frontend
  ports:
  - port: 80
    targetPort: 80
  type: ClusterIP
EOF
# Create the backend service
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: resilient-apps
spec:
  replicas: 3

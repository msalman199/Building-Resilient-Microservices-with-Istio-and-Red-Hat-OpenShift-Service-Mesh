# Check Istio version
istioctl version
Now, let's create a namespace for our microservices and enable Istio injection:

# Create namespace for our applications
kubectl create namespace resilient-apps

# Enable Istio sidecar injection
kubectl label namespace resilient-apps istio-injection=enabled

# Verify the label
kubectl get namespace resilient-apps --show-labels
Deploy our sample microservices application:

# Create the frontend service
cat <<EOF | kubectl apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: resilient-apps
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
        version: v1
    spec:
      containers:
      - name: frontend
        image: nginx:1.21
        ports:
        - containerPort: 80
        env:

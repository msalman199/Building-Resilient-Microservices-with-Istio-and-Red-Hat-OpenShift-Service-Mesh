Subtask 2.3: Test Circuit Breaker Functionality
Let's create a script to test circuit breaker behavior:

# Create a script to generate high error rates
cat <<EOF > /tmp/circuit-breaker-test.sh
#!/bin/bash
LOAD_TESTER_POD=\$(kubectl get pod -l app=load-tester -n resilient-apps -o jsonpath='{.items[0].metadata.name}')

echo "Starting circuit breaker test..."
echo "Phase 1: Normal requests"
for i in {1..5}; do
  echo -n "Request \$i: "
  kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -o /dev/null -w "%{http_code}\n" http://backend:8080/
  sleep 1
done

echo -e "\nPhase 2: Generating failures to trigger circuit breaker"
for i in {1..10}; do
  echo -n "Failure request \$i: "
  kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -H "test-fault: abort" -o /dev/null -w "%{http_code}\n" http://backend:8080/
  sleep 0.5
done

echo -e "\nPhase 3: Testing if circuit breaker is open (should see fast failures)"
for i in {1..5}; do
  echo -n "Post-failure request \$i: "
  kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -o /dev/null -w "HTTP: %{http_code}, Time: %{time_total}s\n" http://backend:8080/
  sleep 1
done

echo -e "\nWaiting for circuit breaker to reset..."
sleep 35

echo "Phase 4: Testing circuit breaker recovery"
for i in {1..5}; do
  echo -n "Recovery request \$i: "
  kubectl exec -n resilient-apps \$LOAD_TESTER_POD -- curl -s -o /dev/null -w "%{http_code}\n" http://backend:8080/
  sleep 2
done
EOF

# Make the script executable and run it
chmod +x /tmp/circuit-breaker-test.sh
bash /tmp/circuit-breaker-test.sh

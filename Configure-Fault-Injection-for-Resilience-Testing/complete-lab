Task 1: Set Up Fault Injection Rules
Subtask 1.1: Verify Lab Environment
First, let's verify that our environment is ready and the sample application is running.

# Check if Istio is installed and running
kubectl get pods -n istio-system

# Verify the Bookinfo application is deployed
kubectl get pods -n default

# Check if services are available
kubectl get services -n default
Expected output should show Istio components running and Bookinfo services (productpage, details, reviews, ratings) deployed.

Subtask 1.2: Enable Istio Sidecar Injection
Ensure that Istio sidecar injection is enabled for our namespace:

# Label the default namespace for automatic sidecar injection
kubectl label namespace default istio-injection=enabled

# Verify the label is applied
kubectl get namespace default --show-labels
Subtask 1.3: Create Destination Rules
Create destination rules to define service subsets for traffic management:

# Create a file for destination rules
cat > destination-rules.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: productpage
spec:
  host: productpage
  subsets:
  - name: v1
    labels:
      version: v1
---
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: reviews
spec:
  host: reviews
  subsets:
  - name: v1
    labels:
      version: v1
  - name: v2
    labels:
      version: v2
  - name: v3
    labels:
      version: v3
---
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: ratings
spec:
  host: ratings
  subsets:
  - name: v1
    labels:
      version: v1
---
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: details
spec:
  host: details
  subsets:
  - name: v1
    labels:
      version: v1
EOF

# Apply the destination rules
kubectl apply -f destination-rules.yaml
Subtask 1.4: Create Basic Virtual Service
Set up a virtual service to route traffic to our services:

# Create virtual service configuration
cat > virtual-service-basic.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: productpage
spec:
  http:
  - match:
    - headers:
        end-user:
          exact: jason
    route:
    - destination:
        host: productpage
        subset: v1
  - route:
    - destination:
        host: productpage
        subset: v1
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: reviews
spec:
  http:
  - route:
    - destination:
        host: reviews
        subset: v1
      weight: 100
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: ratings
spec:
  http:
  - route:
    - destination:
        host: ratings
        subset: v1
---
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: details
spec:
  http:
  - route:
    - destination:
        host: details
        subset: v1
EOF

# Apply the virtual services
kubectl apply -f virtual-service-basic.yaml
Task 2: Simulate Latency and Failed Requests
Subtask 2.1: Configure HTTP Delay Fault Injection
Now we'll inject artificial delays to simulate network latency issues:

# Create fault injection configuration for delay
cat > fault-injection-delay.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: ratings-delay
spec:
  hosts:
  - ratings
  http:
  - match:
    - headers:
        end-user:
          exact: jason
    fault:
      delay:
        percentage:
          value: 100.0
        fixedDelay: 7s
    route:
    - destination:
        host: ratings
        subset: v1
  - route:
    - destination:
        host: ratings
        subset: v1
EOF

# Apply the delay fault injection
kubectl apply -f fault-injection-delay.yaml
This configuration will inject a 7-second delay for 100% of requests to the ratings service when the request header contains end-user: jason.

Subtask 2.2: Test Delay Injection
Let's test the delay injection by accessing the application:

# Get the ingress gateway URL
export INGRESS_HOST=$(kubectl -n istio-system get service istio-ingressgateway -o jsonpath='{.status.loadBalancer.ingress[0].ip}')
export INGRESS_PORT=$(kubectl -n istio-system get service istio-ingressgateway -o jsonpath='{.spec.ports[?(@.name=="http2")].port}')
export GATEWAY_URL=$INGRESS_HOST:$INGRESS_PORT

# Test normal request (should be fast)
time curl -s -o /dev/null -w "%{http_code}\n" http://$GATEWAY_URL/productpage

# Test request with jason user (should have delay)
time curl -s -o /dev/null -w "%{http_code}\n" -H "end-user: jason" http://$GATEWAY_URL/productpage
Subtask 2.3: Configure HTTP Abort Fault Injection
Now let's simulate service failures by injecting HTTP abort faults:

# Create fault injection configuration for abort
cat > fault-injection-abort.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: ratings-abort
spec:
  hosts:
  - ratings
  http:
  - match:
    - headers:
        end-user:
          exact: jason
    fault:
      abort:
        percentage:
          value: 100.0
        httpStatus: 500
    route:
    - destination:
        host: ratings
        subset: v1
  - route:
    - destination:
        host: ratings
        subset: v1
EOF

# Apply the abort fault injection
kubectl apply -f fault-injection-abort.yaml
This configuration will return HTTP 500 errors for 100% of requests to the ratings service when the request header contains end-user: jason.

Subtask 2.4: Test Abort Injection
Test the abort fault injection:

# Test normal request (should work normally)
curl -s -w "%{http_code}\n" http://$GATEWAY_URL/productpage

# Test request with jason user (should show error handling)
curl -s -w "%{http_code}\n" -H "end-user: jason" http://$GATEWAY_URL/productpage
Subtask 2.5: Configure Combined Fault Injection
Let's create a more realistic scenario with both delay and abort faults:

# Create combined fault injection configuration
cat > fault-injection-combined.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: ratings-combined
spec:
  hosts:
  - ratings
  http:
  - match:
    - headers:
        end-user:
          exact: jason
    fault:
      delay:
        percentage:
          value: 50.0
        fixedDelay: 5s
      abort:
        percentage:
          value: 30.0
        httpStatus: 503
    route:
    - destination:
        host: ratings
        subset: v1
  - route:
    - destination:
        host: ratings
        subset: v1
EOF

# Apply the combined fault injection
kubectl apply -f fault-injection-combined.yaml
This configuration will:

Inject 5-second delays for 50% of requests
Return HTTP 503 errors for 30% of requests
Allow 20% of requests to proceed normally
Task 3: Monitor Service Behavior and Response to Failures
Subtask 3.1: Set Up Monitoring Dashboard
Access the monitoring tools to observe the impact of fault injection:

# Port forward to access Grafana dashboard
kubectl -n istio-system port-forward svc/grafana 3000:3000 &

# Port forward to access Jaeger tracing
kubectl -n istio-system port-forward svc/jaeger 16686:16686 &

# Port forward to access Kiali service mesh dashboard
kubectl -n istio-system port-forward svc/kiali 20001:20001 &
Subtask 3.2: Generate Test Traffic
Create a script to generate continuous traffic for monitoring:

# Create traffic generation script
cat > generate-traffic.sh << 'EOF'
#!/bin/bash

GATEWAY_URL=$1
DURATION=${2:-300}  # Default 5 minutes
END_TIME=$((SECONDS + DURATION))

echo "Generating traffic to $GATEWAY_URL for $DURATION seconds..."

while [ $SECONDS -lt $END_TIME ]; do
    # Normal user traffic
    curl -s -o /dev/null http://$GATEWAY_URL/productpage &
    
    # Jason user traffic (with faults)
    curl -s -o /dev/null -H "end-user: jason" http://$GATEWAY_URL/productpage &
    
    # Wait between requests
    sleep 2
done

wait
echo "Traffic generation completed"
EOF

# Make script executable
chmod +x generate-traffic.sh

# Run traffic generation
./generate-traffic.sh $GATEWAY_URL 180
Subtask 3.3: Monitor Service Metrics
While traffic is running, observe the metrics:

# Check service mesh metrics
kubectl -n istio-system exec -it deployment/prometheus -- promtool query instant 'istio_requests_total'

# View error rates
kubectl -n istio-system exec -it deployment/prometheus -- promtool query instant 'rate(istio_requests_total{response_code!~"2.."}[5m])'

# Check latency percentiles
kubectl -n istio-system exec -it deployment/prometheus -- promtool query instant 'histogram_quantile(0.99, rate(istio_request_duration_milliseconds_bucket[5m]))'
Subtask 3.4: Analyze Circuit Breaker Behavior
Configure and test circuit breaker patterns:

# Create destination rule with circuit breaker
cat > circuit-breaker.yaml << 'EOF'
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: ratings-circuit-breaker
spec:
  host: ratings
  trafficPolicy:
    outlierDetection:
      consecutiveErrors: 3
      interval: 30s
      baseEjectionTime: 30s
      maxEjectionPercent: 50
    connectionPool:
      tcp:
        maxConnections: 10
      http:
        http1MaxPendingRequests: 10
        maxRequestsPerConnection: 2
        maxRetries: 3
        consecutiveGatewayErrors: 5
        interval: 30s
        baseEjectionTime: 30s
EOF

# Apply circuit breaker configuration
kubectl apply -f circuit-breaker.yaml
Subtask 3.5: Test Resilience Patterns
Test how the application handles various failure scenarios:

# Create resilience test script
cat > resilience-test.sh << 'EOF'
#!/bin/bash

GATEWAY_URL=$1

echo "Testing application resilience..."

echo "1. Testing normal operation:"
for i in {1..5}; do
    response=$(curl -s -w "%{http_code}" -o /dev/null http://$GATEWAY_URL/productpage)
    echo "Request $i: HTTP $response"
done

echo -e "\n2. Testing with fault injection (jason user):"
for i in {1..5}; do
    start_time=$(date +%s.%N)
    response=$(curl -s -w "%{http_code}" -o /dev/null -H "end-user: jason" http://$GATEWAY_URL/productpage)
    end_time=$(date +%s.%N)
    duration=$(echo "$end_time - $start_time" | bc)
    echo "Request $i: HTTP $response (${duration}s)"
done

echo -e "\n3. Testing retry behavior:"
kubectl apply -f - << 'RETRY_EOF'
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: ratings-retry
spec:
  hosts:
  - ratings
  http:
  - route:
    - destination:
        host: ratings
        subset: v1
    retries:
      attempts: 3
      perTryTimeout: 2s
RETRY_EOF

sleep 5

for i in {1..3}; do
    start_time=$(date +%s.%N)
    response=$(curl -s -w "%{http_code}" -o /dev/null -H "end-user: jason" http://$GATEWAY_URL/productpage)
    end_time=$(date +%s.%N)
    duration=$(echo "$end_time - $start_time" | bc)
    echo "Retry test $i: HTTP $response (${duration}s)"
done
EOF

# Make script executable and run
chmod +x resilience-test.sh
./resilience-test.sh $GATEWAY_URL

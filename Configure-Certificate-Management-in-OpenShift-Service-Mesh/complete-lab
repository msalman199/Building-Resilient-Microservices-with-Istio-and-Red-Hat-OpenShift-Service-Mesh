Subtask 1.3: Configure Certificate Authority Settings
Create Custom Certificate Authority Configuration
# Create a configuration file for custom CA settings
cat << 'EOF' > ca-config.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: ca-config
  namespace: istio-system
data:
  ca-cert-validity: "8760h"  # 1 year
  workload-cert-validity: "24h"  # 1 day for automatic rotation
  cert-chain-file: |
    # Certificate chain configuration
EOF

# Apply the CA configuration
oc apply -f ca-config.yaml
Update Service Mesh Control Plane for Certificate Management
# Create an updated SMCP configuration with certificate management settings
cat << 'EOF' > smcp-cert-config.yaml
apiVersion: maistra.io/v2
kind: ServiceMeshControlPlane
metadata:
  name: basic
  namespace: istio-system
spec:
  version: v2.4
  security:
    certificateAuthority:
      type: Istiod
      istiod:
        type: PrivateKey
        privateKey:
          rootCADir: /etc/cacerts
    identity:
      type: Kubernetes
  general:
    logging:
      componentLevels:
        default: info
  tracing:
    type: Jaeger
  addons:
    grafana:
      enabled: true
    kiali:
      enabled: true
    prometheus:
      enabled: true
EOF

# Apply the updated SMCP configuration
oc apply -f smcp-cert-config.yaml
Subtask 1.4: Enable Automatic Certificate Rotation
Configure Certificate Rotation Policy
# Create a certificate rotation policy
cat << 'EOF' > cert-rotation-policy.yaml
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: default
  namespace: cert-management-demo
spec:
  mtls:
    mode: STRICT
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cert-rotation-config
  namespace: cert-management-demo
data:
  rotation-interval: "1h"
  renewal-threshold: "30m"
EOF

# Apply the certificate rotation policy
oc apply -f cert-rotation-policy.yaml
Verify Certificate Rotation Configuration

Task 3: Monitor Certificate Expiry and Renewal
Subtask 3.1: Set Up Certificate Monitoring
Create Certificate Monitoring Script
# Create a monitoring script for certificate expiry
cat << 'EOF' > cert-monitor.sh
#!/bin/bash

NAMESPACE="cert-management-demo"
echo "=== Certificate Monitoring Report ==="
echo "Timestamp: $(date)"
echo "Namespace: $NAMESPACE"
echo ""

# Get all pods in the namespace
PODS=$(oc get pods -n $NAMESPACE -l app=sample-app -o jsonpath='{.items[*].metadata.name}')

for POD in $PODS; do
    echo "--- Pod: $POD ---"
    
    # Check if the pod has istio-proxy container
    if oc get pod $POD -n $NAMESPACE -o jsonpath='{.spec.containers[*].name}' | grep -q istio-proxy; then
        echo "Istio sidecar detected"
        
        # Extract certificate expiry information
        CERT_INFO=$(oc exec -n $NAMESPACE $POD -c istio-proxy -- cat /etc/ssl/certs/cert-chain.pem 2>/dev/null | openssl x509 -text -noout 2>/dev/null | grep -A2 "Validity")
        
        if [ $? -eq 0 ]; then
            echo "Certificate Validity:"
            echo "$CERT_INFO"
            
            # Extract expiry date
            EXPIRY_DATE=$(echo "$CERT_INFO" | grep "Not After" | cut -d: -f2- | xargs)
            echo "Certificate expires: $EXPIRY_DATE"
            
            # Calculate days until expiry
            EXPIRY_EPOCH=$(date -d "$EXPIRY_DATE" +%s 2>/dev/null)
            CURRENT_EPOCH=$(date +%s)
            
            if [ $? -eq 0 ]; then
                DAYS_UNTIL_EXPIRY=$(( (EXPIRY_EPOCH - CURRENT_EPOCH) / 86400 ))
                echo "Days until expiry: $DAYS_UNTIL_EXPIRY"
                
                if [ $DAYS_UNTIL_EXPIRY -lt 1 ]; then
                    echo "⚠️  WARNING: Certificate expires in less than 1 day!"
                elif [ $DAYS_UNTIL_EXPIRY -lt 7 ]; then
                    echo "⚠️  NOTICE: Certificate expires in less than 7 days"
                else
                    echo "✅ Certificate validity is good"
                fi
            fi
        else
            echo "❌ Could not retrieve certificate information"
        fi
    else
        echo "No Istio sidecar found"
    fi
    echo ""
done

echo "=== End of Report ==="
EOF

# Make the script executable
chmod +x cert-monitor.sh

# Run the monitoring script
./cert-monitor.sh
Subtask 3.2: Configure Automated Certificate Renewal Monitoring
Create a CronJob for Regular Certificate Monitoring
# Create a CronJob for automated certificate monitoring
cat << 'EOF' > cert-monitor-cronjob.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  name: cert-monitor
  namespace: cert-management-demo
spec:
  schedule: "0 */6 * * *"  # Run every 6 hours
  jobTemplate:
    spec:
      template:
        spec:
          serviceAccountName: cert-monitor-sa
          containers:
          - name: cert-monitor
            image: registry.redhat.io/ubi8/ubi:latest
            command:
            - /bin/bash
            - -c
            - |
              # Install required tools
              yum install -y openssl curl
              
              # Certificate monitoring logic
              echo "=== Automated Certificate Check ==="
              echo "Timestamp: $(date)"
              
              # Check certificates in all pods
              for pod in $(oc get pods -n cert-management-demo -l app=sample-app -o jsonpath='{.items[*].metadata.name}'); do
                echo "Checking pod: $pod"
                
                # Extract certificate expiry
                cert_expiry=$(oc exec -n cert-management-demo $pod -c istio-proxy -- cat /etc/ssl/certs/cert-chain.pem | openssl x509 -enddate -noout | cut -d= -f2)
                echo "Certificate expires: $cert_expiry"
                
                # Calculate days until expiry
                expiry_epoch=$(date -d "$cert_expiry" +%s)
                current_epoch=$(date +%s)
                days_until_expiry=$(( (expiry_epoch - current_epoch) / 86400 ))
                
                echo "Days until expiry: $days_until_expiry"
                
                if [ $days_until_expiry -lt 2 ]; then
                  echo "⚠️  Certificate renewal needed for pod $pod"
                fi
              done
          restartPolicy: OnFailure
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cert-monitor-sa
  namespace: cert-management-demo
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: cert-monitor-role
  namespace: cert-management-demo
rules:
- apiGroups: [""]
  resources: ["pods", "pods/exec"]
  verbs: ["get", "list", "create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: cert-monitor-binding
  namespace: cert-management-demo
subjects:
- kind: ServiceAccount
  name: cert-monitor-sa
  namespace: cert-management-demo
roleRef:
  kind: Role
  name: cert-monitor-role
  apiGroup: rbac.authorization.k8s.io
EOF

# Apply the CronJob configuration
oc apply -f cert-monitor-cronjob.yaml
